{"nodes": [{"id": "docs_relatorio_eda_fase3_ivs_elsi", "label": "Relat\u00f3rio EDA Fase 3 IVS/ELSI (12/06/2026)", "file_type": "document", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Pedro Dias Soares", "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_gradiente_norte_sul", "label": "Gradiente Norte\u2192Sul de desigualdade", "file_type": "concept", "rationale": "Norte lidera inadequa\u00e7\u00e3o de \u00e1gua (mediana 19,9% dos setores) e densidade (3,20); Nordeste tem pior renda (R$ 1.693) e analfabetismo (5,3%); Sul \u00e9 a mais bem-atendida; contraste de 55 p.p. Norte-Sul em ra\u00e7a/cor.", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_correlacao_renda_raca", "label": "Correla\u00e7\u00e3o Spearman renda \u00d7 PPI = \u22120,81", "file_type": "concept", "rationale": "Maior correla\u00e7\u00e3o absoluta entre todos os pares; renda \u00d7 analfabetismo = \u22120,75; analfabetismo \u00d7 PPI = +0,62.", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_raca_proxy_vulnerabilidade", "label": "Ra\u00e7a/cor como proxy de vulnerabilidade estrutural", "file_type": "rationale", "rationale": "A correla\u00e7\u00e3o renda \u00d7 PPI de \u22120,81 sustenta a inclus\u00e3o de ra\u00e7a/cor no IVS como proxy de vulnerabilidade socioecon\u00f4mica estrutural (nota de rodap\u00e9 pendente na Tabela 5 do Plano do Artigo).", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_dois_fatores_latentes", "label": "Estrutura de dois fatores latentes (socioecon\u00f4mico + saneamento)", "file_type": "concept", "rationale": "Fator 1 socioecon\u00f4mico (renda invertida, analfabetismo, PPI, raz\u00e3o de moradores) dominante; Fator 2 saneamento (\u00e1gua, esgoto, lixo); lixo \u00e9 o componente mais aut\u00f4nomo (correla\u00e7\u00f5es \u2264 0,23).", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_recomendacao_spearman", "label": "Recomenda\u00e7\u00e3o: Spearman como entrada da an\u00e1lise fatorial", "file_type": "rationale", "rationale": "Spearman recomendado por causa da forte assimetria (2,2 a 4,7) e infla\u00e7\u00e3o de zeros das vari\u00e1veis de saneamento e renda.", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_iqr_nao_informativo", "label": "Regra IQR n\u00e3o informativa em distribui\u00e7\u00f5es zero-infladas", "file_type": "rationale", "rationale": "Com P25=P50=0, a regra 1,5\u00d7IQR rotula ~20% dos setores como outliers em \u00e1gua/esgoto/lixo \u2014 artefato, n\u00e3o erro. N\u00e3o excluir setores por outliers de saneamento: os bols\u00f5es s\u00e3o o objeto do estudo. Usar P95 no artigo.", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_normalizacao_renda_municipio", "label": "Normaliza\u00e7\u00e3o de renda por munic\u00edpio (recomenda\u00e7\u00e3o)", "file_type": "rationale", "rationale": "Min-max global comprime a raz\u00e3o de 5,18\u00d7 entre Portel/PA (R$ 1.022) e S\u00e3o Caetano do Sul/SP (R$ 5.292) e trata mercados de renda distintos como um s\u00f3; normaliza\u00e7\u00e3o por munic\u00edpio \u00e9 necess\u00e1ria para a an\u00e1lise intraurbana (Notebook 03).", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_lixo_cacamba", "label": "Ca\u00e7amba contada como lixo inadequado (decis\u00e3o intencional)", "file_type": "rationale", "rationale": "O IVS-BH 2012 (C\u00e1lculo IVS2012.docx, Tabela 3, V037/2010 \u2192 V00398/2022) conta ca\u00e7amba de servi\u00e7o de limpeza como inadequada; s\u00f3 coleta porta-a-porta (V00397) \u00e9 adequada. Explica Salto/SP (~86% ca\u00e7amba). N\u00e3o \u00e9 bug; pela defini\u00e7\u00e3o da OMS seria adequada \u2014 eventual mudan\u00e7a \u00e9 decis\u00e3o metodol\u00f3gica com a orientadora.", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_framework_fiocruz_eda", "label": "Framework FIOCRUZ de EDA (guia_analises.docx)", "file_type": "concept", "rationale": "Checklist do M\u00f3dulo 2 do Curso de An\u00e1lise de Dados FIOCRUZ: caracterizar estrutura/qualidade, detectar padr\u00f5es e outliers, escolher m\u00e9tricas adequadas, verificar pressupostos antes da modelagem.", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_sigilo_ibge", "label": "Sigilo do IBGE (marcador X)", "file_type": "concept", "rationale": "IBGE suprime com X c\u00e9lulas de setores pequenos (<5 domic\u00edlios); convertido para NaN no NB02. Atinge 15,8% dos setores OK em V00901 (analfabetismo), concentrado em grandes cidades \u2014 vi\u00e9s sistem\u00e1tico a discutir no artigo.", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_correcao_virgula_decimal", "label": "Corre\u00e7\u00e3o do separador decimal em V06004", "file_type": "rationale", "rationale": "V06004 vem com v\u00edrgula decimal ('2453,03'); sem substitui\u00e7\u00e3o por ponto, ~98% dos valores viravam NaN. Corre\u00e7\u00e3o recuperou 106.262 valores v\u00e1lidos.", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_relatorio_eda_fase3_ivs_elsi_tukey_1977", "label": "Tukey 1977 \u2014 Exploratory Data Analysis", "file_type": "paper", "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "source_url": null, "captured_at": null, "author": "Tukey J.W.", "contributor": null}], "edges": [{"source": "docs_relatorio_eda_fase3_ivs_elsi", "target": "notebooks_fase3_eda_elsi_02_analises_descritivas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "weight": 1.0}, {"source": "docs_relatorio_eda_fase3_ivs_elsi", "target": "banco_de_dados_eda_readme_saidas_eda", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "weight": 1.0}, {"source": "docs_relatorio_eda_fase3_ivs_elsi", "target": "docs_relatorio_eda_fase3_ivs_elsi_framework_fiocruz_eda", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "weight": 1.0}, {"source": "docs_relatorio_eda_fase3_ivs_elsi", "target": "docs_plano_artigo_cientifico_ic_preenchido", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/Relatorio_EDA_Fase3_IVS_ELSI.md", "source_location": null, "weight": 1.0}, {"source": "docs_relatorio_eda_fase3_ivs_