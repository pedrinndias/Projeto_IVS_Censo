# Ignorar arquivos grandes e temporários de base de dados
banco_de_dados/*.csv
banco_de_dados/*.xlsx
banco_de_dados/*.db
banco_de_dados/~*

# Bases derivadas pesadas em subpastas (regeneráveis via notebooks)
# Mantemos as tabelas-resumo pequenas (descritivas_*, correlacao_*, outliers,
# missing_*, elegibilidade_*, extremos_*, diagnostico_proporcoes_*) versionadas
# como histórico de execução, mas excluímos qualquer Base_*.csv e o
# diagnostico de esgoto (uma linha por setor, ~4 MB).
banco_de_dados/**/Base_*.csv
banco_de_dados/**/diagnostico_esgoto_*.csv
banco_de_dados/**/*_por_setor.csv

dados/*.csv
dados/output/*.csv
dados/processed/*.xlsx
formatar/*.csv
docs/*.xlsx
~*
# Outros arquivos de backup
*.bak
*.tmp
*.log

# Configuração local do Claude Code (worktrees, settings locais)
.claude/
# Exceções: mantenha scripts e documentação
!formatar/*.py
!README.md
!estrutura_projeto.md
!requirements.txt
!src/**
!docs/*.md
!tests/**
!dados/municipios_elsi_brasil.csv
# Exceção: entregáveis específicos para a orientadora (mantidos no histórico)
!banco_de_dados/entrega_orientadora/
!banco_de_dados/entrega_orientadora/*.csv
!banco_de_dados/entrega_orientadora/*.db
!banco_de_dados/entrega_orientadora/*.md
